POSTGRES_PASSWORD=replace-me
NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://hub:replace-me@localhost:5432/calendar_hub
TEST_DATABASE_URL=postgresql://hub:replace-me@localhost:5432/calendar_hub_test
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
TOKEN_ENCRYPTION_KEY=
PROVIDER_TIMEOUT_MS=15000
# Optional Outlook input: leave ALL four empty to keep Outlook disabled.
# Supply locally after user/tenant app registration; never paste secrets in chat.
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=

# Optional Phase 4 read-only relay runtime; configure only after authorized bot setup.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_IDS=

# Phase5 operator gate: leave false until bounded live acceptance is explicitly authorized.
AUTOMATION_LIVE_WRITES_ENABLED=false
